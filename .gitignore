# --------------------
# Data (ALL derived + raw)
# --------------------
# No trailing slash on these two: a trailing slash matches directories ONLY, and the Sonic
# staging in docs/audit/BRIEF_STAGE_TO_SONIC.md creates both as SYMLINKS into scratch. Git sees
# a symlink as a file, so "data/" missed it, every seed tree read as dirty, and the campaign
# launcher refused to submit. Do not re-add the slashes.
data
pretrain_weights
model_weights/
bin/
# Cluster working directory: 19 GB of fetched results, and the older campaign scripts
# hard-code the UCD login. Publishable, parameterised job scripts go in sonic/campaign/.
sonic/*
!sonic/campaign/

# --------------------
# Logs / outputs
# --------------------
lightning_logs/
wandb/
logs/

# --------------------
# TikZ in-place build artifacts (canonical figure outputs live in figures/)
# --------------------
scripts/figures/*.pdf
scripts/figures/*.aux
scripts/figures/*.log

# --------------------
# Regenerable derived outputs (rebuilt by RUNBOOK.sh; proprietary-data-derived, not shareable).
# Final paper figures are committed once, post-campaign.
# --------------------
evaluation/evaluation_results/
analysis/per_tile_cms/
analysis/*.npz
analysis/bootstrap_results.*
analysis/seed_aggregate/
.campaign/
figures/*.pdf
figures/*.png
figures/graphical_abstract/
artifacts/tile_number_metrics.json
artifacts/sampler_weights.tsv

# --------------------
# Python
# --------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/

# --------------------
# Environments
# --------------------
.env
.env.*
*.conda
*.egg-info/

# --------------------
# Private working notes — never published
# --------------------
notes/

# --------------------
# Manuscript — gitignored during submission. After publication, delete the
# `manuscript/` line to publish it, but keep manuscript/Definitions/ ignored
# (MDPI-copyrighted class files).
# --------------------
manuscript/
main_proposed.tex

# --------------------
# LaTeX build artifacts
# --------------------
*.aux
*.log
*.fls
*.fdb_latexmk

# --------------------
# Editor
# --------------------
.vscode/

# --------------------
# OS
# --------------------
.DS_Store
Thumbs.db

# Legacy/archived configs — kept locally, never published
config/biodiversity/_archive/

# Regenerable analysis outputs (drafts, stale KD, imagery-derived previews) — not shared.
# Leading slash matters: unanchored, this also matched scripts/analysis/ and silently kept
# seven analysis scripts out of the repo.
/analysis/
evaluation/bakeoff_gates/

# Archived cut-figure outputs (kept locally, out of git)
_archive/
references_md/

# Split-builder caches (regenerable; keyed to source mtimes)
artifacts/_cache/

# Pre-rewrite manuscript snapshots (2026-07-27), kept out of the repo like _archive/
_archived_new/
